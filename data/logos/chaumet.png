  x-cloak
  class="flex w-full flex-col items-center px-4"
>
  <div class="w-full max-w-3xl">
    <template x-for="(hit, index) in $store.search.faq" :key="hit.objectID">

<div
  class="group/accordion border-b border-blue/25"
  x-data="{ expanded: false }"
  :data-state="expanded ? 'open' : 'closed'"
  @click="$store.algoliaTracking.trackClick('faq', hit.objectID, index + 1)"
>
  <button
    type="button"
    class="flex w-full cursor-pointer items-center justify-between gap-4 py-5 text-start focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 focus-visible:outline-none"
    :aria-expanded="expanded"
    @click="expanded = !expanded"
  >
    <span class="text-courant text-blue">
      <span x-text="hit.title"></span>
    </span>
    <span
      class="flex shrink-0 rotate-0 items-center justify-center transition-transform duration-300 ease-out group-data-[state=open]/accordion:rotate-180"
      aria-hidden="true"
    >



<svg
  class="inline-block size-3 shrink-0 rotate-90  text-blue/50"
  xmlns="http://www.w3.org/2000/svg"
  width="8"
  height="13"
  viewBox="0 0 8 13"
  fill="none"
>
  <path d="M0.355469 0.355469L6.35547 6.35547L0.35547 12.3555" stroke="currentColor"/>
</svg>
</span>
  </button>

  <div
    class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out group-data-[state=open]/accordion:grid-rows-[1fr]"
    :aria-hidden="!expanded"
  >
    <div
      x-cloak
      class="invisible overflow-hidden transition-[visibility] duration-300 group-data-[state=open]/accordion:visible"
    >
      <div
        class="flex flex-col gap-2 pb-5 text-courant text-blue/50"
        x-data="
          {
            showMore: false,
            init() {
              this.$watch('expanded', (val) => {
                if (val) {
                  this.$nextTick(() => {
                    this.showMore = this.$refs.description.scrollHeight > this.$refs.description.clientHeight;
                  });
                }
              });
            }
          }
        "
      >
        <div class="line-clamp-3" x-ref="description">
          <template x-if="hit.content_highlighted">
            <div x-html="hit.content_highlighted"></div>
          </template>
          <template x-if="!hit.content_highlighted && hit.content">
            <div x-html="hit.content"></div>
          </template>
        </div>
        
        
        





  <a
    href="/zh-cn/pages/faq"
    class="inline-flex w-fit items-center rounded-sm text-blue text-courant underline-animated   transition-[background-color,border-color] duration-300 ease-luxury focus-utility-6 disabled:opacity-50 disabled:pointer-events-none aria-disabled:opacity-50 aria-disabled:pointer-events-none"
    
    
    
    
            x-show="showMore"
            :href="'/zh-cn/pages/faq' + '?q=' + hit.handle"
          
  >阅读更多</a>

</div>
    </div>
  </div>
</div>
