</form>
<ul
  x-show="$store.search.query.length > 0 && $store.search.suggestions.length > 0"
  x-cloak
  aria-label="搜索"
  class="flex flex-col gap-2 text-courant text-blue"
>
  <template x-for="suggestion in $store.search.suggestions" :key="suggestion.objectID">
    <li>
      <button
        type="button"
        class="cursor-pointer text-start leading-relaxed text-blue/50"
        x-html="highlightSuggestion(suggestion)"
        @click="selectSuggestion(suggestion.query)"
      ></button>
    </li>
  </template>
</ul>
</div>
        </div>
<div
  x-show="$store.search.query.length > 0 && ($store.search.productsCount > 0 || $store.search.editorialCount > 0 || $store.search.faqCount > 0)"
  x-cloak
  class="flex w-full flex-col gap-4 lg:flex-content"
>
  <div
    x-data="
      {
        _focusTab(delta) {
          const tabs = [...this.$el.querySelectorAll('[role=tab]:not([aria-disabled=\'true\'])')];
          const i = tabs.indexOf(document.activeElement);
          if (i === -1) return;
          tabs[(i + delta + tabs.length) % tabs.length].focus();
        }
      }
    "
    class="flex w-full items-start"
    role="tablist"
    aria-label="搜索"
    @keydown.arrow-right.prevent="_focusTab(1)"
    @keydown.arrow-left.prevent="_focusTab(-1)"
    @keydown.home.prevent="const tabs = [...$el.querySelectorAll('[role=tab]:not([aria-disabled=\'true\'])')]; tabs[0]?.focus()"
    @keydown.end.prevent="const tabs = [...$el.querySelectorAll('[role=tab]:not([aria-disabled=\'true\'])')]; tabs[tabs.length - 1]?.focus()"
  >
    <button
      type="button"
      role="tab"
      id="overlay-tab-products"
      :aria-selected="($store.search.activeTab === 'products').toString()"
      :aria-disabled="($store.search.productsCount === 0).toString()"
      :tabindex="$store.search.activeTab === 'products' ? 0 : -1"
      aria-controls="overlay-tabpanel-products"
      class="flex items-center justify-center border-b px-4 pb-2 text-heading-2 uppercase transition-colors lg:flex-1"
      :class="
        $store.search.productsCount === 0
        ? 'border-blue/25 text-blue/50 cursor-default'
        : $store.search.activeTab === 'products' ? 'border-blue text-blue' : 'border-blue/25 text-blue'
      "
      @click="$store.search.productsCount > 0 && $store.search.setTab('products')"
    >
      <span>
        作品
        (<span x-text="$store.search.productsCount"></span>)
      </span>
    </button>

    <button
      type="button"
      role="tab"
      id="overlay-tab-editorial"
      :aria-selected="($store.search.activeTab === 'editorial').toString()"
      :aria-disabled="($store.search.editorialCount === 0).toString()"
      :tabindex="$store.search.activeTab === 'editorial' ? 0 : -1"
      aria-controls="overlay-tabpanel-editorial"
      class="flex items-center justify-center border-b px-4 pb-2 text-heading-2 uppercase transition-colors lg:flex-1"
      :class="
        $store.search.editorialCount === 0
        ? 'border-blue/25 text-blue/50 cursor-default'
        : $store.search.activeTab === 'editorial' ? 'border-blue text-blue' : 'border-blue/25 text-blue'
      "
      @click="$store.search.editorialCount > 0 && $store.search.setTab('editorial')"
    >
      <span>
        CHAUMET
        (<span x-text="$store.search.editorialCount"></span>)
      </span>
    </button>

    <button
      type="button"
      role="tab"
      id="overlay-tab-faq"
      :aria-selected="($store.search.activeTab === 'faq').toString()"
      :aria-disabled="($store.search.faqCount === 0).toString()"
      :tabindex="$store.search.activeTab === 'faq' ? 0 : -1"
      aria-controls="overlay-tabpanel-faq"
      class="flex items-center justify-center border-b px-4 pb-2 text-heading-2 uppercase transition-colors lg:flex-1"
      :class="
        $store.search.faqCount === 0
        ? 'border-blue/25 text-blue/50 cursor-default'
        : $store.search.activeTab === 'faq' ? 'border-blue text-blue' : 'border-blue/25 text-blue'
      "
      @click="$store.search.faqCount > 0 && $store.search.setTab('faq')"
    >
      <span>
        常见问题
        (<span x-text="$store.search.faqCount"></span>)
      </span>
    </button>
  </div></div><div
  id="overlay-tabpanel-products"
  role="tabpanel"
  aria-labelledby="overlay-tab-products"
  x-show="$store.search.activeTab === 'products' && $store.search.products.length > 0"
  x-cloak
  class="relative flex w-full flex-col items-center"
><div
    x-show="$store.search.loading"
    x-cloak
    x-transition:enter="transition-opacity duration-300 ease-luxury"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition-opacity duration-300 ease-luxury"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="absolute inset-0 z-10 flex items-center justify-center bg-light-silver/80"
    role="status"
    aria-live="polite"
  >
    <div class="animate-loader-pulse">



<svg
  xmlns="http://www.w3.org/2000/svg"
  version="1.1"
  viewBox="0 0 380.7 137.69"
  width="118"
  height="48"
  fill="currentColor"
  
    role="img"
    aria-label="Chaumet Diadem"
  
  class="text-blue/30"
>
