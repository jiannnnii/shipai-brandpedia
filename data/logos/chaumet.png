    <span class="sr-only">加载中……</span>
  </div>

  <div class="grid w-full grid-cols-2 lg:grid-cols-4">
    <template
      x-for="(hit, index) in $store.search.products.slice(0, 8)"
      :key="hit.objectID"
    ><a
  :href="$store.search.getProductUrl(hit.handle)"
    :data-scroll-anchor="hit.objectID"
  @click="$store.algoliaTracking.trackClick('products', hit.objectID, index + 1); $store.tracking.selectItem(hit, &#39;Search &gt; &#39; + $store.search.query, index + 1, 'algolia')"
  class="group flex w-full flex-col gap-4 pb-4 lg:gap-8 lg:pb-8"
  :class="
    (() => {return index % 2 === 0 ? 'bg-gradient-pdp-up' : 'bg-gradient-pdp-down';})()
  "
><div class="relative flex aspect-square w-full overflow-hidden">
    <div class="flex size-full lg:block">
      <div class="size-full shrink-0 lg:absolute lg:inset-0">
        <template x-if="hit.image">
          <img
            :src="hit.image"
            :alt="$store.search.getProductAlt(hit)"
            class="size-full object-cover"
            loading="lazy"
            width="600"
            height="600"
          >
        </template>
      </div>
    </div><div
      class="absolute inset-x-4 top-4 flex items-center lg:inset-x-8 lg:top-8"
      :class="$store.search.getProductLabel(hit) ? 'justify-between' : 'justify-end'"
    >
      <template x-if="$store.search.getProductLabel(hit)"><span
          class="inline-flex items-center justify-center gap-2 rounded-[1px] bg-white px-2 py-1 text-courant-sm text-blue/50 capitalize"
          x-text="$store.search.getProductLabel(hit)"
        ></span>
      </template><button
        type="button"
        x-data="wishlistCta({ variantId: parseInt(hit.objectID), productId: parseInt(hit.product_id), handle: hit.handle, engravable: false, siteLocation: &#39;Search &gt; &#39; + $store.search.query, gtmAlgoliaHit: hit })"
        @click.stop.prevent="toggle()"
        :class="{ 'opacity-50': !isInWishlist }"
        :aria-label="isInWishlist ? &quot;从收藏列表移除&quot; : &quot;加入收藏列表&quot;"
        class="inline-flex items-center justify-center rounded-full text-blue transition-colors focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 focus-visible:outline-none"
      >
        <span x-show="!isInWishlist">
          




  <svg
    class="size-6 shrink-0 size-5 text-current"
    style="--icon-stroke-width: 1"
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    
      aria-hidden="true"
    
    focusable="false"
  >
    <path d="M15.2676 6.5C15.6835 6.50001 16.0953 6.58203 16.4795 6.74121C16.8636 6.90038 17.2128 7.13368 17.5068 7.42773H17.5078C17.802 7.72181 18.0351 8.07176 18.1943 8.45605C18.3535 8.84025 18.4355 9.25211 18.4355 9.66797C18.4355 10.0838 18.3535 10.4957 18.1943 10.8799C18.0352 11.264 17.8018 11.6132 17.5078 11.9072H17.5068L16.8008 12.6143L11.9678 17.4473L6.42773 11.9072C5.83387 11.3132 5.50002 10.5079 5.5 9.66797C5.5 8.82789 5.83371 8.02176 6.42773 7.42773C7.02174 6.83382 7.82797 6.5 8.66797 6.5C9.50778 6.50012 10.3133 6.83395 10.9072 7.42773L11.9678 8.48828L12.3213 8.13477L13.0273 7.42773C13.3214 7.13352 13.6714 6.90044 14.0557 6.74121C14.4399 6.58205 14.8517 6.5 15.2676 6.5Z" stroke="currentColor" stroke-linecap="square"/>
  </svg>


        </span>
        <span x-show="isInWishlist" x-cloak>
          




  <svg
    class="size-6 shrink-0 size-5 text-current"
    style="--icon-stroke-width: 1"
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    
      aria-hidden="true"
    
    focusable="false"
  >
    
      <path d="M15.2676 6.5C15.6835 6.50001 16.0953 6.58203 16.4795 6.74121C16.8636 6.90038 17.2128 7.13368 17.5068 7.42773H17.5078C17.802 7.72181 18.0351 8.07176 18.1943 8.45605C18.3535 8.84025 18.4355 9.25211 18.4355 9.66797C18.4355 10.0838 18.3535 10.4957 18.1943 10.8799C18.0352 11.264 17.8018 11.6132 17.5078 11.9072H17.5068L16.8008 12.6143L11.9678 17.4473L6.42773 11.9072C5.83387 11.3132 5.50002 10.5079 5.5 9.66797C5.5 8.82789 5.83371 8.02176 6.42773 7.42773C7.02174 6.83382 7.82797 6.5 8.66797 6.5C9.50778 6.50012 10.3133 6.83395 10.9072 7.42773L11.9678 8.48828L12.3213 8.13477L13.0273 7.42773C13.3214 7.13352 13.6714 6.90044 14.0557 6.74121C14.4399 6.58205 14.8517 6.5 15.2676 6.5Z" fill="currentColor" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="square"/>

      
  </svg>


        </span>
      </button>
    </div>
  </div><div class="flex flex-1 flex-col gap-2 px-4 text-blue lg:px-8">
    <div class="flex flex-col items-start">
      <span
        class="text-heading-2 uppercase"
        x-text="$store.search.getProductCollection(hit)"
      ></span>
      <span
        class="line-clamp-2 text-courant-sm"
        x-text="hit.title"
      ></span>
    </div>
    <div class="mt-auto flex items-center justify-between gap-1 text-courant-sm"><span x-html="$store.search.getDisplayPrice(hit)"></span><template x-if="$store.search.getVariationsLabel(hit)">
        <span
          class="text-blue/50"
          x-text="$store.search.getVariationsLabel(hit)"
        ></span>
      </template>
    </div>
  </div>
</a>
</template>
  </div></div><div
  id="overlay-tabpanel-editorial"
  role="tabpanel"
  aria-labelledby="overlay-tab-editorial"
  x-show="$store.search.activeTab === 'editorial' && $store.search.editorial.length > 0"
  x-cloak
  class="flex-content flex w-full flex-col items-center"
  :data-active-tab="$store.search.activeTab"
  :data-has-editorial="$store.search.editorial.length > 0"
>
  <div class="grid w-full grid-cols-1 gap-4 lg:grid-cols-2">
    <template x-for="(hit, index) in $store.search.editorial" :key="hit.objectID">

<a
  :href="`${window.Shopify?.routes?.root ?? '/'}pages/${hit.handle}`"
  class="flex flex-col gap-2"
  @click="$store.algoliaTracking.trackClick('pages', hit.objectID, index + 1)"
>
  <template x-if="hit.image">
    <img
      :src="hit.image"
      :alt="hit.title"
      class="aspect-video w-full shrink-0 object-cover"
      loading="lazy"
      width="600"
      height="300"
    >
  </template>
  <span class="text-courant text-blue" x-text="hit.title"></span>
  <template x-if="hit.body_html_safe_highlighted">
    <p class="line-clamp-2 text-courant text-blue/50" x-html="hit.body_html_safe_highlighted"></p>
  </template>
  <template x-if="!hit.body_html_safe_highlighted && hit.body_html_safe">
    <p class="line-clamp-2 text-courant text-blue/50" x-text="hit.body_html_safe"></p>
  </template>
</a>
</template>
  </div><div
    x-show="$store.search.loadingMoreEditorial"
    x-cloak
    class="flex w-full items-center justify-center py-8 text-blue"
    role="status"
    aria-live="polite"
  >
    <div class="animate-loader-pulse">



