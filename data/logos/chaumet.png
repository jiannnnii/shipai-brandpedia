<div
  x-data="
    wishlistErrorToast({
      full: &quot;您的收藏列表已满（最多可收藏100款作品）。&quot;,
      tooLarge: &quot;您的收藏列表空间不足，无法保存此次修改。&quot;,
      loginRequired: &quot;请登录以更新您的收藏列表。&quot;,
      throttled: &quot;请求过于频繁。请稍后重试。&quot;,
      network: &quot;连接出现问题。请重试。&quot;,
      generic: &quot;发生错误。请重试。&quot;,
      empty: &quot;您的收藏列表为空，请先添加作品&quot;,
      mergeTruncated: &quot;部分作品未能保存（超出100件上限）。已为您保留最新添加的作品。&quot;,
      itemNotFound: &quot;此作品已从您的收藏列表中移除。&quot;,
      itemConflict: &quot;此组合已存在于您的收藏列表中。&quot;,
      shareLinkCopied: &quot;链接已复制&quot;
    })
  "
  x-show="visible"
  x-transition:enter="transition-opacity duration-200"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition-opacity duration-200"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  role="status"
  aria-live="polite"
  class="fixed start-1/2 bottom-4 z-overlay max-w-sm -translate-x-1/2 bg-near-white px-4 py-3 text-error shadow-lg"
  x-cloak=""
>
  <div class="flex items-start gap-3">
    <p class="flex-1 text-courant" x-text="message"></p>
    <button
      type="button"
      @click="dismiss()"
      :aria-label="&quot;关闭&quot;"
      class="shrink-0 cursor-pointer text-error/70 hover:text-error"
    >
      &times;
    </button>
  </div>
</div>

      
<div
  x-data="wishlistAnnouncer({ removed: &quot;从收藏列表移除&quot; })"
  class="sr-only"
  role="status"
  aria-live="polite"
  aria-atomic="true"
  x-text="message"
></div>


      



<script>
  (() => {
    'use strict';

    /**
     * OneTrust to Shopify Consent Bridge
     *
     * Maps OneTrust cookie categories to Shopify consent types:
     * - C0002: Performance cookies → analytics
     * - C0003: Functional cookies → preferences
     * - C0004: Targeting cookies → marketing
     * - C0005: Social media cookies → marketing
     */
    const OneTrustShopifyBridge = {
      maxRetries: 50,
      retryInterval: 100,
      retryCount: 0,

      /**
       * Initialize the consent bridge
       */
      init() {
        this.waitForOneTrust();
      },

      /**
       * Poll for OneTrust SDK availability
       */
      waitForOneTrust() {
        if (typeof OneTrust !== 'undefined' && typeof OneTrust.OnConsentChanged === 'function') {
          this.setupConsentListener();
          // Initial sync restores a previous visit's choice — not a consent
          // change, so it must not re-fire page_view in the pixel.
          this.syncCurrentConsent(false);
        } else if (this.retryCount < this.maxRetries) {
          this.retryCount++;
          setTimeout(() => this.waitForOneTrust(), this.retryInterval);
        } else {
          console.warn('[OneTrust Bridge] OneTrust SDK not available after maximum retries');
        }
      },

      /**
       * Set up listener for consent changes
       */
      setupConsentListener() {
        OneTrust.OnConsentChanged(() => this.syncCurrentConsent(true));
      },

      /**
       * Sync current OneTrust consent state to Shopify
       * @param {boolean} isConsentChange - true when the user just accepted or
       *   changed their choice (banner / preference center), false for the
       *   passive sync that restores a previous visit's state on page load.
       */
      syncCurrentConsent(isConsentChange) {
        const activeGroups = this.getActiveGroups();
        const shopifyConsent = this.mapToShopifyConsent(activeGroups);

        this.updateShopifyConsent(shopifyConsent);

        if (isConsentChange) {
          this.publishConsentEvent(activeGroups, shopifyConsent);
        }
      },

      /**
       * Forward the consent change into the Shopify web pixel sandbox.
       * @param {string[]} activeGroups - Active OneTrust group IDs
       * @param {Object} consent - Mapped Shopify consent booleans
       */
      publishConsentEvent(activeGroups, consent) {
        const publish = window.Shopify?.analytics?.publish;

        if (typeof publish !== 'function') {
          console.warn('[OneTrust Bridge] Shopify analytics not available');
          return;
        }

        publish('onetrust_consent_theme', {
          active_groups: activeGroups,
          onetrust_active_groups: activeGroups.length ? `,${activeGroups.join(',')},` : '',
          analytics: consent.analytics,
          preferences: consent.preferences,
          marketing: consent.marketing,
        });
      },

      /**
       * Get active OneTrust consent groups
       * @returns {string[]} Array of active group IDs (e.g., ['C0001', 'C0002'])
       */
      getActiveGroups() {
        // OneTrust stores active groups in OptanonActiveGroups or via OnetrustActiveGroups
        let groups = [];

        if (typeof OptanonActiveGroups !== 'undefined' && OptanonActiveGroups) {
          // OptanonActiveGroups is a comma-separated string like ",C0001,C0002,"
          groups = OptanonActiveGroups.split(',').filter((group) => group.trim() !== '');
        } else if (typeof OneTrust !== 'undefined' && OneTrust.GetDomainData) {
          try {
            const domainData = OneTrust.GetDomainData();
            if (domainData && domainData.Groups) {
              domainData.Groups.forEach((group) => {
                if (group.Status === 'active') {
                  groups.push(group.CustomGroupId);
                }
              });
            }
          } catch (e) {
            console.warn('[OneTrust Bridge] Error getting domain data:', e);
          }
        }

        return groups;
      },

      /**
       * Map OneTrust categories to Shopify consent types
       * @param {string[]} activeGroups - Array of active OneTrust group IDs
       * @returns {Object} Shopify consent object
       */
      mapToShopifyConsent(activeGroups) {
        const hasAnalytics = activeGroups.includes('C0002');
        const hasPreferences = activeGroups.includes('C0003');
        const hasTargeting = activeGroups.includes('C0004');
        const hasSocialMedia = activeGroups.includes('C0005');

        return {
          analytics: hasAnalytics,
          preferences: hasPreferences,
          marketing: hasTargeting || hasSocialMedia,
        };
      },

      /**
       * Update Shopify consent tracking API
       * @param {Object} consent - Consent object with analytics, preferences, marketing booleans
       */
      updateShopifyConsent(consent) {
        if (
          typeof window.Shopify === 'undefined' ||
          typeof window.Shopify.customerPrivacy === 'undefined'
        ) {
          console.warn('[OneTrust Bridge] Shopify Customer Privacy API not available');
          return;
        }

        const customerPrivacy = window.Shopify.customerPrivacy;

        const currentConsent = {
          analytics: customerPrivacy.analyticsProcessingAllowed(),
          preferences: customerPrivacy.preferencesProcessingAllowed(),
          marketing: customerPrivacy.marketingAllowed(),
        };

        const hasChanged =
          currentConsent.analytics !== consent.analytics ||
          currentConsent.preferences !== consent.preferences ||
          currentConsent.marketing !== consent.marketing;

        if (hasChanged) {
          customerPrivacy.setTrackingConsent(
            {
              analytics: consent.analytics,
              preferences: consent.preferences,
              marketing: consent.marketing,
            },
            () => {},
          );
        }
      },
    };

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => OneTrustShopifyBridge.init());
    } else {
      OneTrustShopifyBridge.init();
    }
  })();
</script>

      <script>window.Shopify = window.Shopify || {};
  window.Shopify.currency = window.Shopify.currency || {};
